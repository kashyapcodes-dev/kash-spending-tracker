{
  "name": "kash-spending-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:security": "sh tools/test-security.sh",
    "format": "turbo run //#prettier:write",
    "format:check": "turbo run //#prettier:check",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "check:repo": "tsx tools/check-repo.ts",
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "db:generate": "pnpm --filter @kash/db db:generate",
    "db:migrate": "pnpm --filter @kash/db db:migrate",
    "db:seed": "tsx tools/seed.ts",
    "kash": "tsx tools/kash.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "globals": "^15.14.0",
    "jiti": "^2.4.2",
    "prettier": "catalog:",
    "tsx": "^4.19.2",
    "turbo": "^2.5.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.20.0",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@kash/core": "workspace:*",
    "@kash/db": "workspace:*"
  }
}
